PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/youtube-summarizer
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=replace_with_any_long_random_string
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
# Comma-separated if you need more than one (e.g. local dev + deployed).
# No trailing slashes — CORS matches the browser's Origin header exactly.
CLIENT_ORIGIN=http://localhost:3000
